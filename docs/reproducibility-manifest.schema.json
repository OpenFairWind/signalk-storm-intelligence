{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openfairwind:storm-intelligence:reproducibility-manifest:1",
  "title": "Storm Intelligence reproducibility manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "case", "datasetVersion", "window", "bounds", "sources", "createdAt", "software"],
  "properties": {
    "schema": { "const": "storm-intelligence-reproducibility/1" },
    "case": { "type": "string", "minLength": 1 },
    "datasetVersion": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["west", "south", "east", "north"],
      "properties": {
        "west": { "type": "number", "minimum": -180, "maximum": 180 },
        "south": { "type": "number", "minimum": -90, "maximum": 90 },
        "east": { "type": "number", "minimum": -180, "maximum": 180 },
        "north": { "type": "number", "minimum": -90, "maximum": 90 }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "kind", "provider", "retrievedAt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "retrievedAt": { "type": "string", "format": "date-time" },
          "request": { "type": "string" },
          "licence": { "type": "string" },
          "documentation": { "type": "string" },
          "redistributable": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "vesselScenario": { "type": ["string", "null"] },
    "referenceAnnotations": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "software": {
      "type": "object",
      "additionalProperties": true,
      "required": ["plugin", "version", "gitCommit"],
      "properties": {
        "plugin": { "const": "signalk-storm-intelligence" },
        "version": { "type": "string" },
        "gitCommit": { "type": "string" },
        "node": { "type": "string" },
        "platform": { "type": "string" }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "role": { "enum": ["development", "training", "validation", "test", "operational-replay"] },
        "researchQuestion": { "type": "string" },
        "primaryMetrics": { "type": "array", "items": { "type": "string" } },
        "algorithms": { "type": "array", "items": { "type": "string" } },
        "ensembleStrategy": { "type": "string" }
      }
    }
  }
}
